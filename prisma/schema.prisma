// BorderShield AI — Prisma Schema
// AI-Based Fake Identity & Document Screening System (SIH 2026, PS 26188)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OFFICER
  ANALYST
}

enum DocumentType {
  PASSPORT
  VISA
  NATIONAL_ID
  DRIVING_LICENSE
  PERMIT
}

enum CaseStatus {
  PENDING
  PROCESSING
  AWAITING_DECISION
  CLEARED
  SECONDARY_INSPECTION
  REJECTED
  REFERRED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WatchlistResult {
  CLEAR
  MATCH_FOUND
  REVIEW_REQUIRED
}

enum DecisionType {
  CLEAR
  SECONDARY_INSPECTION
  REJECT
  REFER_TO_INVESTIGATION
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OFFICER)
  badgeId      String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  screeningCases ScreeningCase[] @relation("CreatedBy")
  decisions      Decision[]
  auditLogs      AuditLog[]

  @@index([email])
  @@index([role])
}

model ScreeningCase {
  id           String       @id @default(cuid())
  caseNumber   String       @unique
  documentType DocumentType
  country      String?
  status       CaseStatus   @default(PENDING)
  isDemo       Boolean      @default(false)
  createdById  String
  createdBy    User         @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  completedAt  DateTime?

  documents           Document[]
  ocrResults           OCRResult[]
  validationResults    ValidationResult[]
  tamperingResults     TamperingResult[]
  faceVerifications    FaceVerification[]
  watchlistChecks      WatchlistCheck[]
  riskAssessments      RiskAssessment[]
  decisions            Decision[]
  auditLogs            AuditLog[]

  @@index([status])
  @@index([caseNumber])
  @@index([createdAt])
}

model Document {
  id            String       @id @default(cuid())
  caseId        String
  case          ScreeningCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentType  DocumentType
  role          String       @default("DOCUMENT") // DOCUMENT | SELFIE
  fileName      String
  storedName    String
  filePath      String
  mimeType      String
  sizeBytes     Int
  sha256        String
  uploadedAt    DateTime     @default(now())

  @@index([caseId])
}

model OCRResult {
  id          String   @id @default(cuid())
  caseId      String
  case        ScreeningCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentId  String
  rawText     String   @db.Text
  fields      Json     // [{ field, value, confidence }]
  overallConfidence Float
  engine      String   @default("tesseract.js")
  correctedBy String?
  createdAt   DateTime @default(now())

  @@index([caseId])
}

model ValidationResult {
  id          String   @id @default(cuid())
  caseId      String
  case        ScreeningCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  checks      Json     // [{ code, label, status: pass|warn|fail, message }]
  passed      Int
  warnings    Int
  failed      Int
  isValid     Boolean
  createdAt   DateTime @default(now())

  @@index([caseId])
}

model TamperingResult {
  id                 String   @id @default(cuid())
  caseId             String
  case               ScreeningCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentId         String
  tamperingDetected  Boolean
  confidence         Float
  indicators         Json     // string[]
  suspiciousRegions  Json     // [{x,y,w,h,label,score}]
  metadataAnalysis   Json
  elaScore           Float
  noiseScore         Float
  compressionScore   Float
  explanation        String   @db.Text
  method             String   @default("Forensic / Heuristic Analysis")
  createdAt          DateTime @default(now())

  @@index([caseId])
}

model FaceVerification {
  id             String   @id @default(cuid())
  caseId         String
  case           ScreeningCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  docFaceFound   Boolean
  selfieFaceFound Boolean
  multipleFaces  Boolean
  similarity     Float?
  matchDecision  String   // MATCH | NO_MATCH | INCONCLUSIVE
  confidenceBand String   // HIGH | MEDIUM | LOW
  explanation    String   @db.Text
  createdAt      DateTime @default(now())

  @@index([caseId])
}

model WatchlistEntry {
  id             String   @id @default(cuid())
  fullName       String
  documentNumber String?  @unique
  nationality    String?
  dateOfBirth    DateTime?
  reason         String
  severity       String   @default("HIGH")
  isDemo         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([documentNumber])
  @@index([fullName])
}

model WatchlistCheck {
  id          String   @id @default(cuid())
  caseId      String
  case        ScreeningCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  queryName   String?
  queryDocNum String?
  result      WatchlistResult
  matchedEntryId String?
  matchScore  Float?
  createdAt   DateTime @default(now())

  @@index([caseId])
}

model RiskAssessment {
  id           String   @id @default(cuid())
  caseId       String
  case         ScreeningCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  score        Int
  level        RiskLevel
  factors      Json     // [{ label, points, reason }]
  recommendation String @db.Text
  createdAt    DateTime @default(now())

  @@index([caseId])
}

model Decision {
  id          String       @id @default(cuid())
  caseId      String
  case        ScreeningCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  officerId   String
  officer     User         @relation(fields: [officerId], references: [id])
  decision    DecisionType
  reason      String       @db.Text
  createdAt   DateTime     @default(now())

  @@index([caseId])
}

model AuditLog {
  id           String   @id @default(cuid())
  caseId       String?
  case         ScreeningCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  eventType    String
  eventData    Json
  previousHash String
  hash         String   @unique
  timestamp    DateTime @default(now())

  @@index([caseId])
  @@index([timestamp])
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
